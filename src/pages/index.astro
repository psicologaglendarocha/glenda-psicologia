---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sobre from '../components/Sobre.astro';
import Terapia from '../components/Terapia.astro';
import Atendimento from '../components/Atendimento.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import Demandas from '../components/Demandas.astro';

const wppLink = "https://api.whatsapp.com/send/?phone=55081992750202&text=Olá,+gostaria+de+saber+mais+sobre+a+terapia&type=phone_number&app_absent=0";
---

<Layout>
  <Header wppLink={wppLink} />
  <main>
    <Hero wppLink={wppLink} />
    <Sobre />
    <Demandas />
    <Terapia />
    <Atendimento />
    <Contato wppLink={wppLink} />
  </main>
  <Footer />
</Layout>